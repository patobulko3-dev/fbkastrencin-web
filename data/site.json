      "qa": [
        {
          "q": "Keď práve nie som pri florbale…",
          "a": "Keďže milujem futbal, určite by som sa venoval manažmentu či trénovaniu vo futbale."
        },
        {
          "q": "Toto by o mne v klube nikto nepovedal",
          "a": "Na staré kolená som sa pustil do štúdia psychológie. A najväčší relax je pre mňa beh a downhill na bicykli."
        },
        {
          "q": "Pesnička, ktorú by som v hale pustil ako prvú",
          "a": "Určite niečo od SAULA. Najradšej asi celý album Od nekonečna do dávna (#Zrkadlá)."
        },
        {
          "q": "Na toto som hrdý, aj keď to nikto nevidí",
          "a": "Že som s väčšinou svojich hráčov a študentov stále v kontakte."
        }
      ]
    },
    {
      "name": "Štefan Rajčan",
      "role": "Šéftréner žiakov a prípravky",
      "text": "",
      "photo": "rajcan-stefan",
      "url": "",
      "qa": [
        {
          "q": "Keď práve nie som pri florbale…",
          "a": "Deň mi začína v práci, potom idem na tréningy. Dni bez tréningu trávim so snúbenicou, chodíme na turistiku, na bicykel a podobne."
        },
        {
          "q": "Toto by o mne v klube nikto nepovedal",
          "a": "Som vášnivý rybár a hubár, aj keď času je na to čoraz menej. Pri tom viem vypnúť a odreagovať sa."
        },
        {
          "q": "Pesnička, ktorú by som v hale pustil ako prvú",
          "a": "Jednoznačne tú majstrovskú, ktorá ma sprevádzala pred každým zápasom. Pre našich starších žiakov to bola dva roky po sebe „Hrali sme kličkovanú“."
        },
        {
          "q": "Na toto som hrdý, aj keď to nikto nevidí",
          "a": "Práca s mládežou a deťmi ma veľmi baví a som hrdý na to, aký mám s nimi vzťah. To sa nenaučíte, to musí človek v sebe mať."
        }
      ]
    },
    {
      "name": "Zdenko Bielik",
      "role": "Tréner juniorov",
      "text": "",
      "photo": "bielik-zdenko",
      "url": "",
      "qa": [
        {
          "q": "Keď práve nie som pri florbale…",
          "a": "Voľného času veľa nezostáva, ale každý rok sa teším na letnú turistiku s kamarátmi po Slovensku či Česku. Príroda, dobrá partia a na chvíľu vypnúť od všetkého."
        },
        {
          "q": "Toto by o mne v klube nikto nepovedal",
          "a": "Že som v podstate pokojný a nekonfliktný človek. Teda pokiaľ sa hrá fér."
        },
        {
          "q": "Pesnička, ktorú by som v hale pustil ako prvú",
          "a": "AC/DC – Thunderstruck alebo Metallica – Enter Sandman. Skrátka niečo poriadne dynamické, čo nakopne nielen hráčov, ale i celú halu!"
        },
        {
          "q": "Na toto som hrdý, aj keď to nikto nevidí",
          "a": "Na to, že sa snažím robiť správne veci, aj keď sa nikto nepozerá."
        }
      ]
    },
